{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "scripts/**",
    "unused/**",
    "dist/**",
    "public/**",
    ".github/**",
    ".agent/**",
    ".vscode/**",
    ".cursor/**",
    "docs/**"
  ],
  "entry": ["src/main.tsx!", "functions/**/*.ts!"],
  "project": ["src/**/*.{ts,tsx}!", "functions/**/*.ts!"],
  "ignoreIssues": {
    "functions/**": ["exports"]
  },
  "ignoreDependencies": ["@typescript/native", "@cloudflare/workers-types"]
}
